@page "/pokemon-box"
@page "/party"
@using PKHeX.Core
@inject NavigationManager Navigate
@inject ClipboardService Clipboard
@inject INotificationService Notification
@inject LoadPokemonService LoadPokemonService
@inject UiModeService UiMode

<PageTitle>Storage</PageTitle>

<Flex Direction="FlexDirection.Vertical" Style="width: 100%; gap: 20px;">
    <PageHeader BackIcon="false" Style="max-width: 100%">
        <TitleTemplate>Storage</TitleTemplate>

        <PageHeaderExtra>
            @* Pokedex mode is grid only - the table is a default-mode affordance. *@
            @if (!UiMode.IsPokedex)
            {
                <Button Type="@ButtonType.Default"
                        Icon="@(_showGrid ? IconType.Outline.Table : IconType.Outline.Appstore)"
                        OnClick="() => _showGrid = !_showGrid">
                    @(_showGrid ? "Table" : "Grid")
                </Button>
            }

            <ButtonOrMenu Actions="ExtraActions" />

            @* Helper for loading *.pk files *@
            <InputFile OnChange="LoadPokemon" @ref="_inputGameFile" class="hidden-file-input"></InputFile>
        </PageHeaderExtra>
    </PageHeader>

    @if (_showGrid || UiMode.IsPokedex)
    {
        <div class="storage-split">
            <PokemonGrid
                PartySlots="@PartySlots"
                BoxSlots="@BoxSlots"
                SlotsPerBox="@SlotsPerBox"
                Selectable
                OnOpen="@(UiMode.IsPokedex ? HandleOpenDetail : default)"
                OpenedPokemon="@_detailPokemon"
                @bind-SelectedPokemons="_selectedPokemonList" />

            @if (UiMode.IsPokedex && _detailPokemon is not null)
            {
                <PokemonDetailPanel
                    Pokemon="@_detailPokemon"
                    Source="@_detailSource"
                    OnClose="@(() => _detailPokemon = null)"
                    OnApplied="@(() => _detailPokemon = null)" />
            }
        </div>
    }
    else
    {
        @* The table takes a single Source for every row, so party and box cannot share one table without
           party rows navigating as though they were box rows. Two tables, each with its own Source. *@
        @if (PartyList.Count > 0)
        {
            <div class="list-section">
                <h3 class="list-section-title">Party</h3>
                <PokemonTable
                    DataSource="@PartyList"
                    Source="PokemonSource.Party" />
            </div>
        }

        <div class="list-section">
            <h3 class="list-section-title">Boxes</h3>
            <PokemonTable
                DataSource="@PokemonList"
                Source="PokemonSource.Box"
                Selectable
                @bind-SelectedPokemons="_selectedPokemonList" />
        </div>
    }
</Flex>

@code {
    [Inject] public required GameService GameService { get; set; }
    [Inject] public required JsService Js { get; set; }

    private InputFile _inputGameFile = default!;

    private bool _showGrid = true;

    /// Pokedex mode only: the Pokemon shown in the side panel / bottom sheet, and which collection it
    /// came from - applying an edit writes back to that collection.
    private Pokemon? _detailPokemon;
    private PokemonSource _detailSource = PokemonSource.Box;

    private IList<ButtonOrMenu.ButtonAction> ExtraActions => new List<ButtonOrMenu.ButtonAction>
    {
        new ()
        {
            Type = ButtonType.Primary,
            Label = "Add",
            OnClickAsync = OnAddItemClick,
        },
        new ()
        {
            Type = ButtonType.Link,
            Icon = IconType.Outline.FolderOpen,
            Label = "Load *.pk",
            OnClickAsync = async () => await Js.ClickOnAsync(_inputGameFile.Element)
        },
        new ()
        {
            Type = ButtonType.Link,
            Icon = IconType.Outline.Calculator,
            Label = "Calculator",
            OnClickAsync = HandleCalculatorClick,
        },
        new ()
        {
            Type = ButtonType.Link,
            Icon = IconType.Outline.Copy,
            Label = "Showdown",
            OnClickAsync = HandleExportShowdownClick,
        },
    };

    /// The table view still wants only the occupied box slots; the grid wants every position.
    private IList<Pokemon> PokemonList => GameService.Game?.Trainer.PokemonBox.All
        .Where(p => p.Species != Species.None).ToList() ?? [];

    private IList<Pokemon> BoxSlots => GameService.Game?.Trainer.PokemonBox.All ?? [];

    private IList<Pokemon> PartySlots => GameService.Game?.Trainer.Party.Pokemons ?? [];

    /// The table view lists only occupied slots, so party gets the same filtering the box list gets.
    private IList<Pokemon> PartyList => PartySlots
        .Where(p => p.Species != Species.None).ToList();

    private int SlotsPerBox => GameService.Game?.SaveFile.BoxSlotCount ?? 30;

    private IList<Pokemon> _selectedPokemonList = [];

    private void HandleOpenDetail(PokemonGrid.SlotOpened opened)
    {
        _detailPokemon = ReferenceEquals(_detailPokemon, opened.Pokemon) ? null : opened.Pokemon;
        _detailSource = opened.Source;
    }

    private Task OnAddItemClick()
    {
        Navigate.NavigateToSearchEncounter();
        return Task.CompletedTask;
    }

    private Task HandleExportShowdownClick()
    {
        var toBeExported = _selectedPokemonList.Any() ? _selectedPokemonList : PokemonList;

        if (toBeExported.Count != 0)
        {
            Clipboard.WriteTextAsync(toBeExported.Showdown());
            _ = Notification.Open(new()
            {
                Message = "Showdown copied to clipboard",
                Description = $"{toBeExported.Count} entries",
                NotificationType = NotificationType.Success,
            });
        }
        else
        {
            _ = Notification.Open(new()
            {
                Message = "No pokemons found in your box",
                NotificationType = NotificationType.Error,
            });
        }

        return Task.CompletedTask;
    }

    private Task HandleCalculatorClick()
    {
        var toBeExported = _selectedPokemonList.Any() ? _selectedPokemonList : PokemonList;
        return Js.OpenSmogonDamageCalc(toBeExported);
    }

    private async Task LoadPokemon(InputFileChangeEventArgs e)
    {
        using MemoryStream ms = new MemoryStream();
        await e.File.OpenReadStream(2 * 1024 * 1000).CopyToAsync(ms);

        LoadPokemonService.Load(ms.ToArray());
    }
}
