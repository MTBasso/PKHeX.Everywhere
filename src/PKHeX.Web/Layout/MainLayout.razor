@inherits LayoutComponentBase
@using PKHeX.Web.Services.Plugins
@implements IDisposable
@inject NavigationManager Navigation
@inject GameService GameService
@inject UiModeService UiMode
@inject UserJourneyService UserJourneyService

<Layout Style="min-height: 100vh" Class="@(UiMode.IsPokedex ? "pokedex-app" : "")">
    <NewsBanner />
    
    <Header Class="@(UiMode.IsPokedex ? "top-bar dex-header" : "top-bar")">

        @*
            Status lights from STYLE_GUIDE.md: blue means a save is loaded. The second lens stays dark -
            it is specified as "unsaved changes", and the app has no dirty-state signal to drive it with,
            so lighting it would be decoration pretending to be status.
        *@
        @if (UiMode.IsPokedex)
        {
            <div class="dex-header__lenses">
                <span class="status-led @(GameService.IsLoaded ? "status-led--loaded" : "")"
                      title="@(GameService.IsLoaded ? "Save loaded" : "No save loaded")"></span>
                <span class="status-led" title="Unsaved changes (not tracked yet)"></span>
            </div>
        }

        <div class="logo @(UiMode.IsPokedex ? "dex-header__title" : "")">PKHeX.Web</div>

        <Menu
            Class="top-nav"
            Theme="MenuTheme.Dark"
            Mode="MenuMode.Horizontal"
            DefaultSelectedKeys="@( [SelectedMenuItem?.Route ?? string.Empty])"
            SelectedKeys="@( [SelectedMenuItem?.Route ?? string.Empty])">
            @foreach (var item in MenuItems)
            {
                @if (!item.VisibleWithoutGame && !GameService.IsLoaded) continue;

                @if (item.Nested is null || item.Nested.Count == 0)
                {
                    @RenderMenu(item)
                }
                else
                {
                    RenderFragment subtitle =
                        @<span>
                            @if (item.Icon is not null)
                            {
                                <Icon Type="@item.Icon" Theme="IconThemeType.Outline"/>
                            }
                            <span>@item.Label</span>
                        </span>;

                    <SubMenu Key="@item.Route" TitleTemplate="subtitle">
                        @foreach (var sub in item.Nested)
                        {
                            @RenderMenu(sub)
                        }
                    </SubMenu>
                }
            }
        </Menu>

        <div class="top-bar-spacer"></div>

        @*
            Saving hands back a new file and never touches the original, so it needs to be reachable from
            anywhere - it used to be a nav entry, and folding that away left it buried on the Saves page.
        *@
        @if (GameService.IsLoaded)
        {
            <Button
                Type="@ButtonType.Primary"
                Icon="@IconType.Outline.Download"
                OnClick="HandleSaveClick">
                Save
            </Button>
        }

        <Button
            Type="@ButtonType.Default"
            Icon="@IconType.Outline.Setting"
            Shape="@ButtonShape.Round"
            OnClick="HandleSettingsClick">
        </Button>
    </Header>
        <Content Style=" margin: 24px 16px 0;">
            <div class="site-layout-background" style="padding: 24px; min-height: 360px">
                <AnalyticsAwareErrorBoundary
                    @ref="_errorBoundary">
                    <ChildContent>
                        @Body
                    </ChildContent>
                    <ErrorContent>
                        <Alert
                            Type="@AlertType.Error"
                            Message="Error"
                            CloseText="Dismiss"
                            OnClose="DismissError"
                            Closable>
                            <Paragraph>
                                @if (IsUnsupportedLoadedPokemonFormat(context))
                                {
                                    <span>
                                        This Pokémon format is not compatible with the currently loaded save file yet. Support for this workflow is on the roadmap.
                                    </span>
                                }
                                else
                                {
                                    <span>Whops, some unexpected error happened.</span>
                                }
                            </Paragraph>

                            @if (ShouldShowIssueLink(context))
                            {
                                <Paragraph>
                                    <a href="@GetIssueLink(context)" target="_blank">Click here</a> to file an issue in GitHub.
                                </Paragraph>
                            }

                            <ResponsibleDescriptions Bordered Size="DescriptionsSize.Small">
                                <DescriptionsItem Title="Id">@context.GetExceptionTrackingId()</DescriptionsItem>
                                <DescriptionsItem Title="Type">@context.GetType().Name</DescriptionsItem>
                                <DescriptionsItem Title="Message">@context.Message</DescriptionsItem>
                            </ResponsibleDescriptions>
                        </Alert>
                    </ErrorContent>
                </AnalyticsAwareErrorBoundary>
            </div>
        </Content>

    @*
        On a phone the top row cannot hold brand, navigation and actions at once - it wrapped into a
        column. Navigation moves to a bar along the bottom edge, which also puts the destinations within
        thumb reach. Hidden entirely on desktop, where the top row has space.
    *@
    <nav class="mobile-nav">
        @foreach (var item in MenuItems)
        {
            @if (!item.VisibleWithoutGame && !GameService.IsLoaded) continue;

            <NavLink class="mobile-nav-item"
                     href="@($"/{item.Route}")"
                     Match="@(string.IsNullOrEmpty(item.Route) ? NavLinkMatch.All : NavLinkMatch.Prefix)">
                @if (item.Icon is not null)
                {
                    <Icon Type="@item.Icon" Theme="IconThemeType.Outline"/>
                }
                <span class="mobile-nav-label">@item.Label</span>
            </NavLink>
        }
    </nav>

    @* The footer was removed - it competed with the mobile bottom bar for the same edge. Its links and
       the app name now live in Settings under About. *@
    <PokemonSyncToast/>

</Layout>

@code {
    [Inject] public required PlugInRegistry PlugInRegistry { get; set; }

    AnalyticsAwareErrorBoundary _errorBoundary = default!;
    MenuItem? SelectedMenuItem => MenuItems.SingleOrDefault(m => m.Route == Navigation.CurrentRoute());

    IEnumerable<MenuItem> MenuItems =>
    [
        new("", "Saves", "folder-open", true),
        new("trainer", "Trainer", "user"),
        new("pokemon-box", "Storage", "inbox"),
    ];

    List<MenuItem> PluginMenuItems
    {
        get
        {
            var plugIns = PlugInRegistry.GetAllPlugins()
                .Select(p => new MenuItem($"plugins/{p.Id}", p.Settings.Manifest.PlugInName))
                .ToList();

            if (plugIns.Any()) plugIns.Add(new MenuItem("plugins", "Manage Plug-Ins"));

            return plugIns;
        }
    }

    protected override void OnInitialized()
    {
        GameService.OnGameLoaded += OnGameLoaded;
        PlugInRegistry.OnPlugInChanged += OnPlugInChanged;
        BrowserWindowService.LoadRequested += OnLoadRequested;
    }

    protected override void OnAfterRender(bool firstRender) => ToLoadIfNotLoaded();

    private void ToLoadIfNotLoaded()
    {
        if (UserJourneyService.IgnoredFirstLoad) return;

        var currentRoute = Navigation.CurrentRoute();
        if (!GameService.IsLoaded && string.IsNullOrWhiteSpace(currentRoute) || currentRoute == "/")
        {
            Navigation.NavigateTo("/load");
        }
    }

    private Task HandleSaveClick() => GameService.ExportToDownload();

    private void OnGameLoaded(object? sender, EventArgs args)
    {
        Navigation.NavigateToTrainer();
    }


    private void OnPlugInChanged(LoadedPlugIn plugin, PlugInRegistry.ChangeType type)
    {
        if (type == PlugInRegistry.ChangeType.Deregistered)
            Navigation.NavigateToPlugIns();
        else
            Navigation.NavigateToPlugIn(plugin);
    }

    private Task OnLoadRequested(BrowserWindowService.SaveLoadedRequested arg)
    {
        GameService.Load(arg.Bytes, arg.FileName);
        Navigation.NavigateToTrainer();

        return Task.CompletedTask;
    }

    private RenderFragment RenderMenu(MenuItem item) =>
        @<MenuItem Key="@item.Route">
            @if (item.Icon is not null)
            {
                <Icon Type="@item.Icon" Theme="IconThemeType.Outline"/>
            }

            <span class="nav-text">
                <a href="@item.Route">@item.Label</a>
            </span>
        </MenuItem>;

    record MenuItem(string Route, string Label, string? Icon = null, bool VisibleWithoutGame = false, List<MenuItem>? Nested = null);

    public void Dispose()
    {
        GameService.OnGameLoaded -= OnGameLoaded;
        PlugInRegistry.OnPlugInChanged -= OnPlugInChanged;
        BrowserWindowService.LoadRequested -= OnLoadRequested;
    }

    private void HandleSettingsClick()
    {
        Navigation.NavigateToSettings();
    }

    private void DismissError()
    {
        _errorBoundary.Recover();
    }

    private static bool ShouldShowIssueLink(Exception context) => !IsUnsupportedLoadedPokemonFormat(context);

    private static bool IsUnsupportedLoadedPokemonFormat(Exception context) =>
        context.Message.Contains("PKM Format needs to be", StringComparison.Ordinal);

    private string GetIssueLink(Exception context) => GitHubRepositoryNewIssue(
        title: $"Error on {ApplicationName}: {context.Message}",
        body: $@"# Error on {ApplicationName}

* **Id**: {context.GetExceptionTrackingId()}
* **Game version**: {GameService.Game?.GameVersionApproximation.Name}
* **Generation**: {GameService.Game?.Generation.ToString()}
## Type
```
{context.GetType().Name}
```

## Message
```
{context.Message}
```

## Stack trace
```
{context.StackTrace}
```",
        labels: ["bug"]);

}