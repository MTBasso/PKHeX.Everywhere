@*
    Was an AntDesign Table, which on a narrow screen collapsed each item into a stacked
    Name / Amount / Action block - three lines per item. An item is one line: icon, name, count, edit.

    The table's sort and filter went with it, so a search box replaces them: a full bag runs to a hundred
    items and scrolling for one is worse than either.
*@

<div class="item-list-controls">
    <Input TValue="string"
           Value="@_search"
           ValueChanged="HandleSearchChanged"
           Placeholder="Search items"
           AllowClear/>
    <span class="item-list-count">@VisibleItems.Count item(s)</span>
</div>

<div class="item-list">
    @foreach (var item in VisibleItems)
    {
        var current = item;
        <div class="item-row">
            <ItemIcon Item="@current.Definition"/>
            <span class="item-name" title="@current.Definition.Name">@current.Definition.Name</span>
            <span class="item-count">@current.Count</span>
            <Button Type="@ButtonType.Link" Size="@ButtonSize.Small" OnClick="() => ShowModalFor(current)">Edit</Button>
        </div>
    }

    @if (VisibleItems.Count == 0)
    {
        <p class="item-list-empty">Nothing here.</p>
    }
</div>

<Modal Title="@("BasicModal")"
       @bind-Visible="@_modalVisible"
       OnOk="@HandleOk"
       OnCancel="@HandleCancel">
    @EditItemCountTemplate()
</Modal>

@code {
    bool _modalVisible = false;

    Inventory.Item? _selectedItem;
    int? _selectedItemCount;

    [Parameter] public required Inventory Inventory { get; set; }
    [Parameter] public IList<Inventory.Item> DataSource { get; set; } = [];
    [Parameter] public bool ShowNone { get; set; } = false;

    IList<Inventory.Item> FilteredDataSource => ShowNone ? DataSource : DataSource.Where(i => !i.IsNone).ToList();

    private string _search = string.Empty;

    private void HandleSearchChanged(string value) => _search = value ?? string.Empty;

    private IList<Inventory.Item> VisibleItems => string.IsNullOrWhiteSpace(_search)
        ? FilteredDataSource
        : FilteredDataSource
            .Where(i => i.Definition.Name.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase))
            .ToList();

    RenderFragment EditItemCountTemplate()
    {
        return
            @<Space Direction="SpaceDirection.Vertical" Align="SpaceAlign.Center" Style="width: 100%; gap: 20px;">
                <AntDesign.InputNumber
                    TValue="int?"
                    @bind-Value="@_selectedItemCount"
                    Min="0"
                    Max="999"/>
                <p>
                    <em>
                        Setting to 0 will remove the item
                    </em>
                </p>
            </Space>
            ;
    }

    void ShowModalFor(Inventory.Item item)
    {
        SetSelectedItem(item);
        _modalVisible = true;
    }

    void SetSelectedItem(Inventory.Item? item)
    {
        _selectedItem = item;
        _selectedItemCount = item?.Count;
    }

    private void HandleOk()
    {
        if (_selectedItem == null || _selectedItemCount == null) return;

        if (_selectedItemCount > 0)
        {
            Inventory.Set(_selectedItem.Id, (uint)_selectedItemCount.Value);
        }
        else
        {
            Inventory.Remove(_selectedItem.Id);
        }

        SetSelectedItem(null);
    }

    private void HandleCancel() => SetSelectedItem(null);

}