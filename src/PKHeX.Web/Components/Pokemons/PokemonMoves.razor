@using PKHeX.Facade.Repositories

@*
    Four moves used to be four bordered Descriptions blocks stacked down the page. They are four fields;
    the PP rides on the label rather than taking a column of its own.
*@
<div class="edit-grid edit-grid-pairs">
    @foreach (var slot in MoveSlots)
    {
        var current = slot;
        <div class="edit-field">
            <span class="edit-label">
                @current.Label
                <span class="edit-hint">PP @current.PP</span>
            </span>
            <span class="edit-value">
                <MoveSelect
                    Moves="PossibleMoves"
                    SelectedMoveId="@current.MoveId"
                    SelectedMoveChanged="newMove => HandleMoveChange(current.Index, newMove)"/>
            </span>
        </div>
    }
</div>

@code {
    private record MoveSlot(string Label, PokemonMove.MoveIndex Index, ushort MoveId, string PP);

    private IEnumerable<MoveSlot> MoveSlots =>
    [
        new("Move 1", PokemonMove.MoveIndex.Move1, Pokemon.Move1.Move.Id, Pokemon.Move1.PP.ToString()),
        new("Move 2", PokemonMove.MoveIndex.Move2, Pokemon.Move2.Move.Id, Pokemon.Move2.PP.ToString()),
        new("Move 3", PokemonMove.MoveIndex.Move3, Pokemon.Move3.Move.Id, Pokemon.Move3.PP.ToString()),
        new("Move 4", PokemonMove.MoveIndex.Move4, Pokemon.Move4.Move.Id, Pokemon.Move4.PP.ToString()),
    ];

    [Parameter] public required Pokemon Pokemon { get; set; }
    [Parameter] public EventCallback<Pokemon> OnPokemonChanged { get; set; }

    private IList<ushort> AlreadyAssigned => Pokemon.Moves
        .Where(m => m.Value.Move != MoveDefinition.None)
        .Select(m => m.Value.Move.Id)
        .ToList();

    private IEnumerable<MoveDefinition> PossibleMoves => MoveRepository.Instance.PossibleMovesFor(Pokemon)
        .Where(m => !AlreadyAssigned.Contains(m.Id))
        .Append(MoveDefinition.None);
    
    private Task HandleMoveChange(PokemonMove.MoveIndex index, MoveDefinition move)
    {
        Pokemon.ChangeMove(index, move);
        return OnPokemonChanged.InvokeAsync(Pokemon);
    }
}