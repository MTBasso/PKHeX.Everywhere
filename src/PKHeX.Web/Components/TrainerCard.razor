<div class="trainer-card">
    <div class="trainer-card-head">
        <span class="trainer-card-badge">@Game.GameVersionApproximation.Name</span>
        <span class="trainer-card-name">@Game.Trainer.Name</span>
        <span class="trainer-card-id">TID @Game.Trainer.Id</span>
    </div>

    <div class="trainer-card-fields">
        <div class="field">
            <span class="field-label">Gender</span>
            <GenderSelector Gender="@Game.Trainer.Gender" OnGenderChanged="OnGenderChanged"/>
        </div>

        <div class="field">
            <span class="field-label">Money</span>
            <AntDesign.InputNumber
                TValue="uint"
                Formatter='value => $"$ {value}"'
                Value="@Game.Trainer.Money.Amount"
                OnChange="newValue => Game.Trainer.Money.Set(newValue)"
                Style="width: 100%; max-width: 170px;"
                Min="0" Max="999999"/>
        </div>

        @if (Game.BattlePoints.IsSupported(out var supported))
        {
            <div class="field">
                <span class="field-label">Battle Points</span>
                <AntDesign.InputNumber
                    TValue="int"
                    Value="@supported.BattlePoints"
                    OnChange="newValue => supported.BattlePoints = newValue"
                    Style="width: 100%; max-width: 170px;"
                    Min="0" Max="@ushort.MaxValue"/>
            </div>
        }

        <div class="field">
            <span class="field-label">Rival</span>
            <span class="field-value">@Game.Trainer.RivalName</span>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public required Game Game { get; set; }
    [Parameter] public EventCallback<Gender> OnGenderChanged { get; set; }
}
